# Hours of content to look back (default: 24)
LOOKBACK_HOURS=24

# Ollama model for summarization, tagging, deduplication, and classification
# Use a lightweight model here (e.g. llama3.2, phi4-mini, gemma3:4b)
SUMMARIZE_MODEL=llama3.2

# Ollama model for final HTML generation orchestration
# Use a strong/thinking model here (e.g. qwen3, deepseek-r1, llama3.3)
GENERATE_MODEL=llama3.2

# Gmail OAuth2 credentials are loaded from ~/keys/kfopenclaw-gmail.env (outside the repo).
# Create that file with:
#   GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
#   GMAIL_CLIENT_SECRET=your-client-secret
#
# Alternatively, point to a downloaded credentials.json file:
# GMAIL_CREDENTIALS=credentials.json

# Path to Gmail OAuth2 token file (auto-created on first run, do not edit)
GMAIL_TOKEN=token.json
